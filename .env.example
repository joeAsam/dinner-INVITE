# Copy to .env.local (and add the same values in your host's environment settings).

# Public address of the site, no trailing slash. Used in emails, QR codes and calendar links.
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# Supabase → Project Settings → API. The service-role key is secret: server only, never commit it.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Youth Choir Week <tickets@your-domain.com>"
EMAIL_REPLY_TO=

# Any long random string. Protects /api/cron/reminders.
CRON_SECRET=
